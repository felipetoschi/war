{
  "name": "dominio",
  "private": true,
  "version": "0.1.0",
  "description": "Jogo de estratégia de conquista de territórios para o navegador",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
